{
  "name": "expense-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env server/index.ts",
    "start": "tsx --env-file-if-exists=.env server/index.ts --production",
    "db:backup": "tsx --env-file-if-exists=.env server/backup-cli.ts",
    "db:migrate": "tsx --env-file-if-exists=.env server/migrate.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "format:check": "prettier --check src server tests *.json *.ts *.html .github/workflows/*.yml",
    "format": "prettier --write src server tests *.json *.ts *.html .github/workflows/*.yml"
  },
  "dependencies": {
    "@fontsource/manrope": "5.3.0",
    "@fontsource/source-sans-3": "5.3.1",
    "better-auth": "1.7.16",
    "better-sqlite3": "13.0.3",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "lucide-react": "1.68.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
